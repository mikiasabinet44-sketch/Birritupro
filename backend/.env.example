# Copy this file to .env (or just export these in your shell) before running
# the server if you want to use these optional settings.

# Port the HTTP server listens on.
PORT=4000

# If set, POST /api/sms/ingest requires a matching X-Webhook-Secret header.
# Strongly recommended once this is reachable from the internet (see README
# "Exposing this to your SMS-forwarder app").
SMS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: turns on Claude for "Ask your books" and re-categorising unclear transactions.
# Leave unset to keep everything offline (built-in rules + statistics).
# PRIVACY: when set, a summary of your books (amounts, categories, customer names, invoice
# numbers) is sent to Anthropic to answer each question.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# Required (on a hosted server) to create/revoke API keys in the UI. Send as X-Admin-Token.
# Without it, key management only works from localhost.
# ADMIN_TOKEN=

# e-Invoicing: "sandbox" (default) validates documents locally and issues SBX- numbers with
# NO legal effect. "mor" is reserved for a real Ministry of Revenue adapter (not implemented).
EINVOICE_MODE=sandbox
